@page
@model _18_MaiDoanTrungKien_FrontEnd.Pages.Auth.LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-header bg-primary text-white text-center py-4 rounded-top-4">
                <h3 class="fw-bold mb-1"><i class="bi bi-box-arrow-in-right me-2"></i>Sign In</h3>
                <p class="mb-0 text-white-50">FUNews Management System</p>
            </div>
            <div class="card-body p-4 p-md-5">
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                        <div>@Model.ErrorMessage</div>
                    </div>
                }

                <form method="post" id="loginForm">
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label fw-semibold">Email address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Input.Email" id="emailInput" class="form-control" placeholder="name@funews.org" autofocus />
                        </div>
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.Password" class="form-label fw-semibold">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-key"></i></span>
                            <input asp-for="Input.Password" id="passwordInput" type="password" class="form-control" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold rounded-3 mb-3 shadow-sm">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                    </button>
                </form>

                <div class="p-3 bg-light rounded-3 border">
                    <div class="small fw-bold text-muted mb-2"><i class="bi bi-info-circle me-1"></i>Quick Test Accounts:</div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm flex-fill" onclick="fillAdmin()">
                            <i class="bi bi-shield-lock me-1"></i>Admin
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm flex-fill" onclick="fillStaff()">
                            <i class="bi bi-person-badge me-1"></i>Staff
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fillAdmin() {
            document.getElementById('emailInput').value = 'admin@FUNewsManagementSystem.org';
            document.getElementById('passwordInput').value = '@@abc123@@';
        }
        function fillStaff() {
            document.getElementById('emailInput').value = 'staff1@funews.org';
            document.getElementById('passwordInput').value = '123456';
        }
    </script>
}

@page
@model IndexModel
@{
    ViewData["Title"] = "Latest University News";
}

<div class="hero-section text-center py-4 mb-4 bg-white rounded-4 shadow-sm border p-4">
    <h1 class="display-6 fw-bold text-primary mb-2">
        <i class="bi bi-newspaper me-2"></i>FUNews Management System
    </h1>
    <p class="lead text-muted mb-4">Official announcements, academic notices, and campus happenings.</p>

    <!-- Search Form -->
    <form method="get" class="row g-2 justify-content-center">
        <div class="col-md-6">
            <div class="input-group input-group-lg">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="SearchKeyword" value="@Model.SearchKeyword" class="form-control border-start-0" placeholder="Search news by title, keyword, author or tag..." />
                @if (!string.IsNullOrEmpty(Model.SearchKeyword))
                {
                    <a asp-page="/Index" class="btn btn-outline-secondary d-flex align-items-center"><i class="bi bi-x-circle"></i></a>
                }
                <button class="btn btn-primary px-4 fw-semibold" type="submit">Search</button>
            </div>
        </div>
    </form>

    <!-- Category Pills -->
    <div class="d-flex flex-wrap justify-content-center gap-2 mt-3">
        <a asp-page="/Index" asp-route-SearchKeyword="@Model.SearchKeyword"
           class="badge rounded-pill text-decoration-none px-3 py-2 @(!Model.SelectedCategoryId.HasValue ? "bg-primary text-white" : "bg-light text-dark border")">
            All Categories
        </a>
        @foreach (var cat in Model.Categories)
        {
            <a asp-page="/Index" asp-route-SelectedCategoryId="@cat.CategoryId" asp-route-SearchKeyword="@Model.SearchKeyword"
               class="badge rounded-pill text-decoration-none px-3 py-2 @(Model.SelectedCategoryId == cat.CategoryId ? "bg-primary text-white" : "bg-light text-dark border")">
                @cat.CategoryName
            </a>
        }
    </div>
</div>

<!-- News Cards Grid -->
@if (Model.Articles.Count == 0)
{
    <div class="text-center py-5 bg-white rounded-4 shadow-sm border">
        <i class="bi bi-journal-x display-3 text-muted"></i>
        <h4 class="mt-3 text-muted">No news articles found</h4>
        <p class="text-muted">Try refining your search keyword or selecting a different category.</p>
        <a asp-page="/Index" class="btn btn-outline-primary btn-sm">Reset Filters</a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var article in Model.Articles)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0 rounded-4 transition-hover">
                    <div class="card-body d-flex flex-column p-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1">
                                <i class="bi bi-folder2-open me-1"></i>@(article.Category?.CategoryName ?? "General")
                            </span>
                            <small class="text-muted">
                                <i class="bi bi-calendar3 me-1"></i>@(article.CreatedDate?.ToString("MMM dd, yyyy") ?? "Recent")
                            </small>
                        </div>

                        <h5 class="card-title fw-bold text-dark mt-2 mb-2 line-clamp-2">
                            @article.NewsTitle
                        </h5>

                        <p class="card-text text-muted line-clamp-3 mb-3 flex-grow-1">
                            @article.Headline
                        </p>

                        <!-- Tags -->
                        <div class="d-flex flex-wrap gap-1 mb-3">
                            @foreach (var tag in article.Tags)
                            {
                                <span class="badge bg-light text-secondary border small">@tag.TagName</span>
                            }
                        </div>

                        <div class="border-top pt-3 d-flex justify-content-between align-items-center mt-auto">
                            <div class="small text-muted">
                                <i class="bi bi-person me-1"></i>@(article.CreatedBy?.AccountName ?? "Staff Author")
                            </div>
                            <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3"
                                    onclick="viewArticleDetail('@article.NewsArticleId')">
                                Read More <i class="bi bi-arrow-right ms-1"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Detail Modal -->
<div class="modal fade" id="articleDetailModal" tabindex="-1" aria-labelledby="articleDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-light">
                <div>
                    <span id="modalCategoryBadge" class="badge bg-primary rounded-pill mb-1"></span>
                    <h5 class="modal-title fw-bold" id="articleDetailModalLabel">News Details</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <h4 id="modalTitle" class="fw-bold text-dark mb-2"></h4>
                <div class="d-flex flex-wrap align-items-center gap-3 text-muted small mb-3 border-bottom pb-3">
                    <span><i class="bi bi-calendar3 me-1"></i><span id="modalCreatedDate"></span></span>
                    <span><i class="bi bi-person me-1"></i><span id="modalAuthor"></span></span>
                    <span><i class="bi bi-link-45deg me-1"></i>Source: <span id="modalSource"></span></span>
                </div>
                <div class="alert alert-secondary py-2 px-3 fw-semibold small" id="modalHeadline"></div>
                <div class="article-content text-dark my-3" id="modalContent" style="white-space: pre-line; line-height: 1.7;"></div>
                <div class="mt-4 pt-3 border-top">
                    <span class="small fw-bold text-muted me-2"><i class="bi bi-tags me-1"></i>Tags:</span>
                    <span id="modalTags" class="d-inline-flex flex-wrap gap-1"></span>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const articles = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Articles, new System.Text.Json.JsonSerializerOptions { ReferenceHandler = System.Text.Json.Serialization.ReferenceHandler.IgnoreCycles }));

        function viewArticleDetail(id) {
            const article = articles.find(a => a.NewsArticleId === id);
            if (!article) return;

            document.getElementById('modalCategoryBadge').textContent = article.Category ? article.Category.CategoryName : 'News';
            document.getElementById('modalTitle').textContent = article.NewsTitle;
            document.getElementById('modalHeadline').textContent = article.Headline;
            document.getElementById('modalContent').textContent = article.NewsContent || '(No content available)';
            document.getElementById('modalSource').textContent = article.NewsSource || 'FUNews';
            document.getElementById('modalCreatedDate').textContent = article.CreatedDate ? new Date(article.CreatedDate).toLocaleString() : 'N/A';
            document.getElementById('modalAuthor').textContent = article.CreatedBy ? article.CreatedBy.AccountName : 'Staff';

            const tagsContainer = document.getElementById('modalTags');
            tagsContainer.innerHTML = '';
            if (article.Tags && article.Tags.length > 0) {
                article.Tags.forEach(tag => {
                    const badge = document.createElement('span');
                    badge.className = 'badge bg-primary-subtle text-primary border';
                    badge.textContent = tag.TagName;
                    tagsContainer.appendChild(badge);
                });
            } else {
                tagsContainer.textContent = 'None';
            }

            const modal = new bootstrap.Modal(document.getElementById('articleDetailModal'));
            modal.show();
        }
    </script>
}

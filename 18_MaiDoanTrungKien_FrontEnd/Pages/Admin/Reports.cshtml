@page
@model _18_MaiDoanTrungKien_FrontEnd.Pages.Admin.ReportsModel
@{
    ViewData["Title"] = "Report Statistics";
}

<div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-header bg-white py-3 border-0">
        <h4 class="fw-bold mb-0 text-primary">
            <i class="bi bi-bar-chart-line-fill me-2"></i>News Report Statistics
        </h4>
        <small class="text-muted">Generate news reports by custom date period (sorted descending by created date)</small>
    </div>

    <div class="card-body p-4">
        <!-- Date Filter Form -->
        <form method="get" class="row g-3 align-items-end mb-4 bg-light p-3 rounded-3 border">
            <div class="col-md-4">
                <label asp-for="StartDate" class="form-label fw-semibold">Start Date</label>
                <input asp-for="StartDate" type="date" class="form-control" />
            </div>
            <div class="col-md-4">
                <label asp-for="EndDate" class="form-label fw-semibold">End Date</label>
                <input asp-for="EndDate" type="date" class="form-control" />
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary rounded-pill px-4 flex-grow-1">
                    <i class="bi bi-filter me-1"></i> Generate Report
                </button>
                <a asp-page="/Admin/Reports" class="btn btn-outline-secondary rounded-pill px-3">Reset</a>
            </div>
        </form>

        <!-- KPI Statistic Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card border-0 bg-primary bg-opacity-10 rounded-4 p-3 text-center">
                    <div class="display-6 fw-bold text-primary">@Model.TotalArticles</div>
                    <div class="text-muted small fw-semibold">TOTAL ARTICLES</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 bg-success bg-opacity-10 rounded-4 p-3 text-center">
                    <div class="display-6 fw-bold text-success">@Model.ActiveArticles</div>
                    <div class="text-muted small fw-semibold">ACTIVE ARTICLES</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 bg-secondary bg-opacity-10 rounded-4 p-3 text-center">
                    <div class="display-6 fw-bold text-secondary">@Model.InactiveArticles</div>
                    <div class="text-muted small fw-semibold">INACTIVE ARTICLES</div>
                </div>
            </div>
        </div>

        <!-- Result Table -->
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 100px;">ID</th>
                        <th>Title & Headline</th>
                        <th>Category</th>
                        <th>Created Date</th>
                        <th>Author</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Articles.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="bi bi-calendar-x fs-4 d-block mb-1"></i> No news articles found in this period.
                            </td>
                        </tr>
                    }
                    @foreach (var article in Model.Articles)
                    {
                        <tr>
                            <td><span class="badge bg-secondary font-monospace">@article.NewsArticleId</span></td>
                            <td>
                                <div class="fw-bold text-dark">@article.NewsTitle</div>
                                <div class="small text-muted text-truncate" style="max-width: 400px;">@article.Headline</div>
                            </td>
                            <td>
                                <span class="badge bg-info-subtle text-info border">
                                    @(article.Category?.CategoryName ?? "General")
                                </span>
                            </td>
                            <td>
                                <small class="text-muted">
                                    <i class="bi bi-clock me-1"></i>@(article.CreatedDate?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")
                                </small>
                            </td>
                            <td>@(article.CreatedBy?.AccountName ?? "Staff")</td>
                            <td>
                                @if (article.NewsStatus)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

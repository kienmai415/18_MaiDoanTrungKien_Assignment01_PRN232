@page
@model _18_MaiDoanTrungKien_FrontEnd.Pages.Staff.NewsArticlesModel
@{
    ViewData["Title"] = "News Articles Management";
}

<div class="card shadow-sm border-0 rounded-4">
    <div class="card-header bg-white py-3 border-0">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h4 class="fw-bold mb-0 text-primary">
                    <i class="bi bi-newspaper me-2"></i>News Articles Management
                </h4>
                <small class="text-muted">Create, edit, assign tags and publish news content</small>
            </div>
            <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm" onclick="openCreateModal()">
                <i class="bi bi-file-earmark-plus-fill me-1"></i> Add News Article
            </button>
        </div>
    </div>

    <div class="card-body p-4">
        <!-- Search Bar -->
        <form method="get" class="row g-2 mb-4">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="Keyword" value="@Model.Keyword" class="form-control" placeholder="Search by title, headline, category or tag..." />
                    @if (!string.IsNullOrEmpty(Model.Keyword))
                    {
                        <a asp-page="/Staff/NewsArticles" class="btn btn-outline-secondary"><i class="bi bi-x"></i></a>
                    }
                    <button class="btn btn-outline-primary" type="submit">Search</button>
                </div>
            </div>
        </form>

        <!-- Articles Table -->
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 100px;">ID</th>
                        <th>Title & Headline</th>
                        <th>Category</th>
                        <th>Tags</th>
                        <th>Created Date</th>
                        <th>Author</th>
                        <th>Status</th>
                        <th class="text-end" style="width: 170px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Articles.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-4 d-block mb-1"></i> No articles found.
                            </td>
                        </tr>
                    }
                    @foreach (var article in Model.Articles)
                    {
                        <tr>
                            <td><span class="badge bg-secondary font-monospace">@article.NewsArticleId</span></td>
                            <td>
                                <div class="fw-bold text-dark text-truncate" style="max-width: 280px;">@article.NewsTitle</div>
                                <div class="small text-muted text-truncate" style="max-width: 280px;">@article.Headline</div>
                            </td>
                            <td>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                    @(article.Category?.CategoryName ?? "General")
                                </span>
                            </td>
                            <td>
                                <div class="d-flex flex-wrap gap-1" style="max-width: 180px;">
                                    @foreach (var tag in article.Tags)
                                    {
                                        <span class="badge bg-light text-secondary border small">@tag.TagName</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <small class="text-muted">
                                    @(article.CreatedDate?.ToString("yyyy-MM-dd") ?? "N/A")
                                </small>
                            </td>
                            <td><small class="text-muted">@(article.CreatedBy?.AccountName ?? "Staff")</small></td>
                            <td>
                                @if (article.NewsStatus)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-1 rounded-pill">Inactive</span>
                                }
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-pill me-1"
                                        onclick="openEditModal('@article.NewsArticleId')">
                                    <i class="bi bi-pencil-square"></i> Edit
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger rounded-pill"
                                        onclick="confirmDelete('@article.NewsArticleId', '@JavaScriptEncoder.Default.Encode(article.NewsTitle)')">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- News Article Modal (Create & Update) -->
<div class="modal fade" id="articleModal" tabindex="-1" aria-labelledby="articleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content rounded-4 border-0 shadow">
            <form method="post" id="articleForm">
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold" id="articleModalLabel">News Article</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="ArticleForm.NewsArticleId" class="form-label fw-semibold">Article ID</label>
                            <input asp-for="ArticleForm.NewsArticleId" id="formArticleId" class="form-control" placeholder="e.g. NA0010" required />
                            <small class="text-muted" id="idHelpText"></small>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="ArticleForm.NewsTitle" class="form-label fw-semibold">Article Title</label>
                            <input asp-for="ArticleForm.NewsTitle" id="formTitle" class="form-control" placeholder="Title of the article" required />
                        </div>

                        <div class="col-12">
                            <label asp-for="ArticleForm.Headline" class="form-label fw-semibold">Headline</label>
                            <input asp-for="ArticleForm.Headline" id="formHeadline" class="form-control" placeholder="Short summary headline" required />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ArticleForm.CategoryId" class="form-label fw-semibold">Category</label>
                            <select asp-for="ArticleForm.CategoryId" id="formCategory" class="form-select" required>
                                <option value="">-- Select Category --</option>
                                @foreach (var c in Model.Categories)
                                {
                                    <option value="@c.CategoryId">@c.CategoryName</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ArticleForm.NewsSource" class="form-label fw-semibold">Source</label>
                            <input asp-for="ArticleForm.NewsSource" id="formSource" class="form-control" placeholder="e.g. Academic Department, PR..." />
                        </div>

                        <div class="col-12">
                            <label asp-for="ArticleForm.NewsContent" class="form-label fw-semibold">Content</label>
                            <textarea asp-for="ArticleForm.NewsContent" id="formContent" class="form-control" rows="5" placeholder="Full body content of the news..."></textarea>
                        </div>

                        <!-- Tag Selection -->
                        <div class="col-12">
                            <label class="form-label fw-semibold d-block"><i class="bi bi-tags me-1"></i>Assign Tags</label>
                            <div class="d-flex flex-wrap gap-2 p-3 bg-light rounded-3 border" id="tagsContainer">
                                @foreach (var tag in Model.Tags)
                                {
                                    <div class="form-check me-3">
                                        <input class="form-check-input tag-checkbox" type="checkbox" name="SelectedTags" value="@tag.TagId" id="tag_@tag.TagId" />
                                        <label class="form-check-label" for="tag_@tag.TagId">@tag.TagName</label>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" asp-for="ArticleForm.NewsStatus" id="formStatus" checked />
                                <label class="form-check-label fw-semibold" for="formStatus">Active / Published</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" id="formSubmitBtn" class="btn btn-primary rounded-pill px-4">Save Article</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-body p-4 text-center">
                <i class="bi bi-trash3-fill text-danger display-4 mb-3 d-block"></i>
                <h5 class="fw-bold mb-2">Confirm Delete</h5>
                <p class="text-muted small mb-4">
                    Are you sure you want to delete article <strong id="deleteArticleTitle"></strong>?
                </p>
                <form method="post" asp-page-handler="Delete" id="deleteForm">
                    <input type="hidden" name="id" id="deleteArticleId" />
                    <div class="d-flex gap-2 justify-content-center">
                        <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger rounded-pill px-3">Delete</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const articles = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Articles, new System.Text.Json.JsonSerializerOptions { ReferenceHandler = System.Text.Json.Serialization.ReferenceHandler.IgnoreCycles }));
        const articleModal = new bootstrap.Modal(document.getElementById('articleModal'));
        const deleteModal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));

        function openCreateModal() {
            document.getElementById('articleModalLabel').textContent = 'Add New Article';
            document.getElementById('articleForm').action = '?handler=Create';
            document.getElementById('formArticleId').value = '';
            document.getElementById('formArticleId').readOnly = false;
            document.getElementById('idHelpText').textContent = 'Unique identifier (e.g. NA0010).';
            document.getElementById('formTitle').value = '';
            document.getElementById('formHeadline').value = '';
            document.getElementById('formCategory').value = '';
            document.getElementById('formSource').value = '';
            document.getElementById('formContent').value = '';
            document.getElementById('formStatus').checked = true;
            document.getElementById('formSubmitBtn').textContent = 'Create Article';

            // Uncheck all tags
            document.querySelectorAll('.tag-checkbox').forEach(cb => cb.checked = false);

            articleModal.show();
        }

        function openEditModal(id) {
            const article = articles.find(a => a.NewsArticleId === id);
            if (!article) return;

            document.getElementById('articleModalLabel').textContent = 'Edit News Article';
            document.getElementById('articleForm').action = '?handler=Update';
            document.getElementById('formArticleId').value = article.NewsArticleId;
            document.getElementById('formArticleId').readOnly = true;
            document.getElementById('idHelpText').textContent = 'ID cannot be changed.';
            document.getElementById('formTitle').value = article.NewsTitle;
            document.getElementById('formHeadline').value = article.Headline;
            document.getElementById('formCategory').value = article.CategoryId || '';
            document.getElementById('formSource').value = article.NewsSource || '';
            document.getElementById('formContent').value = article.NewsContent || '';
            document.getElementById('formStatus').checked = article.NewsStatus;
            document.getElementById('formSubmitBtn').textContent = 'Update Article';

            // Check tagged checkboxes
            const taggedIds = (article.Tags || []).map(t => t.TagId);
            document.querySelectorAll('.tag-checkbox').forEach(cb => {
                cb.checked = taggedIds.includes(parseInt(cb.value));
            });

            articleModal.show();
        }

        function confirmDelete(id, title) {
            document.getElementById('deleteArticleId').value = id;
            document.getElementById('deleteArticleTitle').textContent = title;
            deleteModal.show();
        }
    </script>
}
